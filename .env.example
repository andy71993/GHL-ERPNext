# ===========================================
# GHL-ERPNext Environment Configuration
# ===========================================

# Application
NODE_ENV=development
PORT=3001

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# ===========================================
# GoHighLevel Configuration
# ===========================================

# GHL API (Get from GHL Settings → Business Profile → API Key)
GHL_API_KEY=your_ghl_api_key_here
GHL_LOCATION_ID=your_location_id_here

# GHL OAuth (For future marketplace app)
# GHL_CLIENT_ID=your_client_id
# GHL_CLIENT_SECRET=your_client_secret
# GHL_REDIRECT_URI=http://localhost:3001/auth/ghl/callback

# ===========================================
# ERPNext Configuration
# ===========================================

# ERPNext Instance URL
ERPNEXT_URL=http://localhost:8000
# For Frappe Cloud: https://yoursite.frappe.cloud

# ERPNext API Credentials (Get from ERPNext → Settings → API Access)
ERPNEXT_API_KEY=your_erpnext_api_key
ERPNEXT_API_SECRET=your_erpnext_api_secret

# Default ERPNext Company (created during setup)
ERPNEXT_DEFAULT_COMPANY=Your Company Name

# ===========================================
# Database (Only if running custom DB)
# ===========================================

# DATABASE_URL=postgresql://user:password@localhost:5432/ghl_erpnext

# ===========================================
# Security
# ===========================================

# JWT Secret for session management
JWT_SECRET=your_super_secret_jwt_key_change_in_production

# Encryption key for storing API credentials
ENCRYPTION_KEY=32_character_encryption_key_here
