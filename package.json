{
  "name": "ghl-erpnext",
  "version": "1.0.0",
  "private": true,
  "description": "GHL + ERPNext Integration - HR, Payroll & Accounting for GoHighLevel",
  "scripts": {
    "dev": "pnpm run --parallel dev",
    "dev:api": "pnpm --filter @ghl-erpnext/api dev",
    "dev:web": "pnpm --filter @ghl-erpnext/web dev",
    "build": "pnpm run --parallel build",
    "build:api": "pnpm --filter @ghl-erpnext/api build",
    "build:web": "pnpm --filter @ghl-erpnext/web build",
    "lint": "pnpm run --parallel lint",
    "test": "pnpm run --parallel test",
    "clean": "pnpm run --parallel clean && rm -rf node_modules",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f"
  },
  "keywords": [
    "gohighlevel",
    "erpnext",
    "hr",
    "payroll",
    "accounting",
    "integration"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.0"
}
